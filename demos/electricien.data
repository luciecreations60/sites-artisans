[{"_1":2},"routes/demos.trade",{"_3":4},"data",{"_5":6},"trade",{"_7":8,"_9":10,"_11":12,"_13":10,"_14":15,"_16":17,"_18":19,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47,"_48":49},"slug","electricien","label","Électricien","labelPlural","Électriciens","shortLabel","tagline","Installations électriques aux normes NF C 15-100","specialty","Rénovation, domotique et mise en sécurité","defaultFirstName","Thomas","defaultLastName","Lefèvre","defaultCompany","Lefèvre Électricité","defaultCity","Nantes","defaultPhone","06 12 34 56 78","defaultEmail","contact@atelier-demo.fr","palette",{"_190":191,"_192":193,"_194":195,"_196":197,"_198":199,"_200":201},"hero",{"_118":188,"_120":189},"atelier",{"_118":185,"_120":187},"portrait",{"_118":185,"_120":186},"about","Électricien qualifié, je réalise des mises aux normes, des rénovations complètes et des installations domotiques légères. Chaque chantier est précédé d’un schéma et d’un devis détaillé. Je remets un consuel ou une attestation de conformité lorsque c’est requis.","services",[163,164,165,166,167],"projects",[99,100,101,102,103,104],"testimonials",[85,86,87],"faqs",[71,72,73,74],"estimator",{"_9":50,"_51":52},"Estimation électrique","options",[53,54,55],{"_56":67,"_9":68,"_59":69,"_61":70},{"_56":63,"_9":64,"_59":65,"_61":66},{"_56":57,"_9":58,"_59":60,"_61":62},"id","tableau","Mise à niveau tableau","base",550,"unit","€","spot","Spot LED encastré",65,"€ / unité","prise","Ajout prise",85,"€ / point",{"_75":83,"_77":84},{"_75":81,"_77":82},{"_75":79,"_77":80},{"_75":76,"_77":78},"question","Quels délais pour une rénovation complète ?","answer","En général une à trois semaines selon la surface et l’accessibilité des combles ou sous-sols.","Intervenez-vous pour un simple dépannage ?","Oui, recherche de panne, remplacement prise ou disjoncteur, sur rendez-vous ou urgence selon dispo.","Puis-je garder une partie de l’ancienne installation ?","Seulement si elle reste conforme après diagnostic. Sinon je vous indique les minimums obligatoires.","Fournissez-vous l’attestation Consuel ?","Oui pour les installations neuves ou les modifications importantes nécessitant un contrôle.",{"_88":96,"_90":97,"_91":98},{"_88":93,"_90":94,"_91":95},{"_88":89,"_90":25,"_91":92},"name","Anne C.","city","text","Rénovation électrique de notre maison des années 70 : plus de disjonctions, tout est carré.","David H.","Saint-Herblain","Borne installée proprement, démarches consuel gérées. Très professionnel.","Isabelle G.","Rezé","Mise aux normes faite en deux jours, explications claires sur ce qui était dangereux avant.",{"_56":156,"_106":157,"_108":25,"_109":158,"_111":159,"_113":160},{"_56":148,"_106":149,"_108":25,"_109":150,"_111":151,"_113":152},{"_56":139,"_106":140,"_108":25,"_109":141,"_111":142,"_113":143},{"_56":130,"_106":131,"_108":25,"_109":132,"_111":133,"_113":134},{"_56":121,"_106":122,"_108":25,"_109":123,"_111":124,"_113":125},{"_56":105,"_106":107,"_108":25,"_109":110,"_111":112,"_113":114},"p6","title","Alarme et vidéosurveillance","location","summary","Centrale filaire, détecteurs ouverture et deux caméras IP.","image",{"_118":119,"_120":107},"tags",[115,116,117],"alarme","domotique","sécurité","src","/sites-artisans/img/electricien/p6.jpg","alt","p5","Appartement rénové T3","Réfection complète gaines et appareillage design dans les pièces de vie.",{"_118":129,"_120":122},[126,127,128],"appartement","rénovation","NF C 15-100","/sites-artisans/img/electricien/p5.jpg","p4","Éclairage jardin LED","Projecteurs encastrés allée et terrasse, minuterie crépusculaire.",{"_118":138,"_120":131},[135,136,137],"extérieur","LED","jardin","/sites-artisans/img/electricien/p4.jpg","p3","Borne recharge garage","Wallbox 7,4 kW avec disjoncteur adapté et passage consuel.",{"_118":147,"_120":140},[144,145,146],"VE","borne","recharge","/sites-artisans/img/electricien/p3.jpg","p2","Cuisine tout-électrique","Four, plaques, lave-vaisselle : circuits dédiés et prises plan de travail.",{"_118":155,"_120":149},[153,154,127],"cuisine","puissance","/sites-artisans/img/electricien/p2.jpg","p1","Tableau neuf maison ancienne","Remplacement tableau vétuste, terre et liaisons équipotentielles refaites.",{"_118":162,"_120":157},[57,161,117],"normes","/sites-artisans/img/electricien/p1.jpg",{"_106":182,"_169":183,"_171":184},{"_106":179,"_169":180,"_171":181},{"_106":176,"_169":177,"_171":178},{"_106":173,"_169":174,"_171":175},{"_106":168,"_169":170,"_171":172},"Domotique et volets connectés","description","Programmation volets, thermostats et interrupteurs connectés compatibles Alexa ou Google.","priceFrom","350 €","Éclairage intérieur et extérieur","Spots LED, bandeaux, détecteurs et éclairage de façade.","120 €","Bornes de recharge véhicule","Étude de puissance, pose murale ou sur pied, raccordement au tableau.","890 €","Rénovation électrique maison","Repiquage complet, prises, éclairages et circuits dédiés cuisine et salle de bain.","4 500 €","Mise aux normes tableau électrique","Remplacement disjoncteurs, différentiels 30 mA, étiquetage et test de l’installation.","650 €","/sites-artisans/img/electricien/atelier.jpg","Portrait artisan électricien","Atelier électricien","/sites-artisans/img/electricien/hero.jpg","Électricien — Rénovation, domotique et mise en sécurité","ink","#1a1a1a","paper","#fafaf8","muted","#6b6b6b","accent","#f5c518","accentSoft","#fef3c7","surface","#f0f0ec"]
