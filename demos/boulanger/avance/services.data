[{"_1":2},"routes/demos.avance.layout",{"_3":4},"data",{"_5":6},"trade",{"_7":8,"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48,"_49":-7},"slug","boulanger","label","Boulanger / Pâtissier","labelPlural","Boulangers","shortLabel","Boulanger","tagline","Pain au levain et pâtisseries artisanales","specialty","Boulangerie tradition et viennoiseries","defaultFirstName","Pierre","defaultLastName","Lambert","defaultCompany","Boulangerie Lambert","defaultCity","Lille","defaultPhone","06 12 34 56 78","defaultEmail","contact@atelier-demo.fr","palette",{"_173":174,"_175":176,"_177":178,"_179":180,"_181":182,"_183":184},"hero",{"_98":171,"_100":172},"atelier",{"_98":168,"_100":170},"portrait",{"_98":168,"_100":169},"about","Boulanger-pâtissier, je pétris et cuise sur place chaque nuit pour servir un pain au levain naturel et des viennoiseries au beurre. Les farines viennent de meuniers du Nord. Commandes spéciales pour événements familiaux ou professionnels sur devis.","services",[146,147,148,149,150],"projects",[78,79,80,81,82,83],"testimonials",[64,65,66],"faqs",[50,51,52,53],"estimator",{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"question","Livrez-vous ?","answer","Livraison gratuite en centre-ville de Lille à partir de 80 € pour les professionnels.","Proposez-vous du bio ?","Une ligne baguette et pain complet en farine bio certifiée, disponible tous les jours.","Commande de gâteau : quel délai ?","Minimum 72 h, une semaine pour les grandes pièces montées ou mariages.","À quelle heure sort le pain ?","Premières baguettes vers 7 h, miche levain vers 8 h 30. Arrivez tôt en week-end.",{"_67":76,"_69":26,"_71":77},{"_67":73,"_69":74,"_71":75},{"_67":68,"_69":70,"_71":72},"name","Maxime D.","city","Tourcoing","text","Gâteau d’anniversaire sur mesure, goût et présentation au top pour le prix annoncé.","SARL Nord Events","Roubaix","Livraisons toujours à l’heure pour nos séminaires. Qualité constante depuis trois ans.","Christine W.","Le pain levain est incomparable, croûte croustillante et mie alvéolée. Mon boulanger du quartier.",{"_84":137,"_86":138,"_88":26,"_89":139,"_91":140,"_93":141},{"_84":128,"_86":129,"_88":26,"_89":130,"_91":131,"_93":132},{"_84":119,"_86":120,"_88":26,"_89":121,"_91":122,"_93":123},{"_84":110,"_86":111,"_88":26,"_89":112,"_91":113,"_93":114},{"_84":101,"_86":102,"_88":26,"_89":103,"_91":104,"_93":105},{"_84":85,"_86":87,"_88":26,"_89":90,"_91":92,"_93":94},"id","p6","title","Bûche de Noël artisanale","location","summary","Parfums praliné, citron et chocolat, décors chocolat blanc.","image",{"_98":99,"_100":87},"tags",[95,96,97],"fêtes","bûche","chocolat","src","/sites-artisans/img/boulanger/p6.jpg","alt","p5","Pain sans gluten du jeudi","Recette dédiée farine riz et sarrasin, cuisson four séparé.",{"_98":109,"_100":102},[106,107,108],"sans gluten","spécialité","boulangerie","/sites-artisans/img/boulanger/p5.jpg","p4","Farandole viennoiseries","Plateau assorti pour inauguration boutique, livraison matinale.",{"_98":118,"_100":111},[115,116,117],"catering","croissant","commande","/sites-artisans/img/boulanger/p4.jpg","p3","Gâteau mariage pièce montée","Choux montés vanille-framboise pour 60 parts, décoration fleurs sucre.",{"_98":127,"_100":120},[124,125,126],"mariage","pâtisserie","événement","/sites-artisans/img/boulanger/p3.jpg","p2","Buffet petit-déjeuner entreprise","120 croissants et 80 pains au chocolat livrés à 7 h en entreprise.",{"_98":136,"_100":129},[133,134,135],"entreprise","viennoiserie","traiteur","/sites-artisans/img/boulanger/p2.jpg","p1","Miche levain 48 h","Farine T65, hydratation 70 %, croûte épaisse caramélisée.",{"_98":145,"_100":138},[142,143,144],"pain","levain","tradition","/sites-artisans/img/boulanger/p1.jpg",{"_86":165,"_152":166,"_154":167},{"_86":162,"_152":163,"_154":164},{"_86":159,"_152":160,"_154":161},{"_86":156,"_1