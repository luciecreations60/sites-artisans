[{"_1":2},"routes/demos.trade",{"_3":4},"data",{"_5":6},"trade",{"_7":8,"_9":10,"_11":12,"_13":10,"_14":15,"_16":17,"_18":19,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47,"_48":-7},"slug","couvreur","label","Couvreur","labelPlural","Couvreurs","shortLabel","tagline","Toiture, zinguerie et charpente","specialty","Réfection toiture, tuiles et ardoises","defaultFirstName","Éric","defaultLastName","Dubois","defaultCompany","Couverture Dubois","defaultCity","Rennes","defaultPhone","06 12 34 56 78","defaultEmail","contact@atelier-demo.fr","palette",{"_172":173,"_174":175,"_176":177,"_178":179,"_180":181,"_182":183},"hero",{"_97":170,"_99":171},"atelier",{"_97":167,"_99":169},"portrait",{"_97":167,"_99":168},"about","Couvreur-zingueur, je répare et refais les toitures en tuiles, ardoises et bac acier dans l’Ille-et-Vilaine. La sécurité du chantier et l’étanchéité durable guident mon travail. Je vous remets un devis photo et un planning avant de commencer.","services",[145,146,147,148,149],"projects",[77,78,79,80,81,82],"testimonials",[63,64,65],"faqs",[49,50,51,52],"estimator",{"_53":61,"_55":62},{"_53":59,"_55":60},{"_53":57,"_55":58},{"_53":54,"_55":56},"question","Faut-il un échafaudage complet ?","answer","Souvent oui pour une réfection ; pour une réparation localisée, un nacelle ou échafaudage partiel suffit.","Quelle garantie sur la couverture ?","Garantie décennale sur l’ouvrage et garantie fabricant sur les tuiles selon les fiches techniques.","Travaillez-vous par tous les temps ?","Non, la pluie et le vent fort arrêtent la pose pour votre sécurité et la qualité de l’étanchéité.","Une réfection complète est-elle éligible MaPrimeRénov’ ?","L’isolation par l’extérieur ou certains travaux couplés peuvent l’être ; je vous oriente vers un conseiller RGE.",{"_66":74,"_68":75,"_69":76},{"_66":71,"_68":72,"_69":73},{"_66":67,"_68":25,"_69":70},"name","Stéphane W.","city","text","Intervention rapide après la tempête. Prix honnête pour la réparation.","Marie-Odile P.","Fougères","Devis détaillé avec photos drone. Le résultat tient ses promesses depuis cinq ans.","Bernard T.","Cesson-Sévigné","Toiture refaite avant l’hiver, équipe soigneuse, chantier nettoyé chaque soir.",{"_83":136,"_85":137,"_87":25,"_88":138,"_90":139,"_92":140},{"_83":127,"_85":128,"_87":25,"_88":129,"_90":130,"_92":131},{"_83":118,"_85":119,"_87":25,"_88":120,"_90":121,"_92":122},{"_83":109,"_85":110,"_87":25,"_88":111,"_90":112,"_92":113},{"_83":100,"_85":101,"_87":25,"_88":102,"_90":103,"_92":104},{"_83":84,"_85":86,"_87":25,"_88":89,"_90":91,"_92":93},"id","p6","title","Charpente renfort fermette","location","summary","Renfort structure suite infiltration, traitement bois inclus.","image",{"_97":98,"_99":86},"tags",[94,95,96],"charpente","structure","réparation","src","/sites-artisans/img/couvreur/p6.jpg","alt","p5","Réparation après tempête","Reprise de 40 tuines et banchement provisoire le jour même.",{"_97":108,"_99":101},[105,106,107],"dépannage","tempête","urgence","/sites-artisans/img/couvreur/p5.jpg","p4","Gouttières zinc neuf","Chéneaux zinc 25/10 sur périphérie complète de la maison.",{"_97":117,"_99":110},[114,115,116],"gouttière","zinc","évacuation","/sites-artisans/img/couvreur/p4.jpg","p3","Lucarne et chatière","Création lucarne côté jardin, étanchéité lead-free conforme.",{"_97":126,"_99":119},[123,124,125],"lucarne","fenêtre","zinguerie","/sites-artisans/img/couvreur/p3.jpg","p2","Ardoises naturelles Bretonne","Pose ardoise sur maison de ville, zinguerie au plomb traditionnelle.",{"_97":135,"_99":128},[132,133,134],"ardoise","patrimoine","couverture","/sites-artisans/img/couvreur/p2.jpg","p1","Toiture tuiles mécaniques","Remplacement de 120 m² de tuiles, velux neufs et noue refaite.",{"_97":144,"_99":137},[141,142,143],"tuile","réfection","étanchéité","/sites-artisans/img/couvreur/p1.jpg",{"_85":164,"_151":165,"_153":166},{"_85":161,"_151":162,"_153":163},{"_85":158,"_