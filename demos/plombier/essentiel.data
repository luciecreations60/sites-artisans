[{"_1":2},"routes/demos.essentiel",{"_3":4},"data",{"_5":6},"trade",{"_7":8,"_9":10,"_11":12,"_13":10,"_14":15,"_16":17,"_18":19,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47,"_48":49},"slug","plombier","label","Plombier","labelPlural","Plombiers","shortLabel","tagline","Plomberie et chauffage de confiance","specialty","Dépannage, sanitaires et installations chauffage","defaultFirstName","Karim","defaultLastName","Benali","defaultCompany","Benali Plomberie","defaultCity","Lyon","defaultPhone","06 12 34 56 78","defaultEmail","contact@atelier-demo.fr","palette",{"_198":199,"_200":201,"_202":203,"_204":205,"_206":207,"_208":209},"hero",{"_117":196,"_119":197},"atelier",{"_117":193,"_119":195},"portrait",{"_117":193,"_119":194},"about","Plombier chauffagiste installé à Lyon depuis douze ans, j’interviens chez les particuliers et les petits commerces. Je privilégie des matériaux reconnus et un diagnostic clair avant chaque intervention. Les urgences fuites et débouchages sont traitées en priorité.","services",[171,172,173,174,175],"projects",[98,99,100,101,102,103],"testimonials",[83,84,85],"faqs",[69,70,71,72],"estimator",{"_9":50,"_51":52},"Estimation dépannage","options",[53,54,55],{"_56":66,"_9":67,"_59":68,"_61":62},{"_56":63,"_9":64,"_59":65,"_61":62},{"_56":57,"_9":58,"_59":60,"_61":62},"id","robinet","Remplacement robinet","base",95,"unit","€","fuite","Recherche de fuite",180,"debouchage","Débouchage simple",120,{"_73":81,"_75":82},{"_73":79,"_75":80},{"_73":77,"_75":78},{"_73":74,"_75":76},"question","Quelle garantie sur les installations ?","answer","Garantie biennale sur l’équipement et décennale sur les ouvrages fixes, conformément à la loi.","Êtes-vous agréé assurance ?","Oui, je peux établir les documents pour votre assurance habitation en cas de sinistre couvert.","Le devis est-il payant ?","Non pour les projets de rénovation. En dépannage simple, le déplacement peut être facturé si vous refusez l’intervention.","Intervenez-vous en urgence le week-end ?","Oui, pour les fuites importantes et les débouchages bloquants, avec majoration affichée au préalable.",{"_86":95,"_88":96,"_90":97},{"_86":92,"_88":93,"_90":94},{"_86":87,"_88":89,"_90":91},"name","Élodie K.","city","Caluire","text","Entretien chaudière et conseils pour baisser la facture. Personne sérieuse et ponctuelle.","Jean-Pierre M.","Lyon 3e","Salle de bain refaite en trois semaines, devis respecté. Je recommande sans hésiter.","Nathalie V.","Villeurbanne","Fuite un dimanche soir : Karim est venu en moins d’une heure et a réglé le problème proprement.",{"_56":155,"_105":156,"_107":25,"_108":157,"_110":158,"_112":159,"_160":161,"_162":163},{"_56":146,"_105":147,"_107":25,"_108":148,"_110":149,"_112":150},{"_56":137,"_105":138,"_107":25,"_108":139,"_110":140,"_112":141},{"_56":129,"_105":130,"_107":25,"_108":131,"_110":132,"_112":133},{"_56":120,"_105":121,"_107":25,"_108":122,"_110":123,"_112":124},{"_56":104,"_105":106,"_107":25,"_108":109,"_110":111,"_112":113},"p6","title","Cuisine équipée raccordée","location","summary","Lave-vaisselle, évier et lave-linge raccordés en une journée.","image",{"_117":118,"_119":106},"tags",[114,115,116],"cuisine","raccordement","plomberie","src","/sites-artisans/img/plombier/p6.jpg","alt","p5","Salle d’eau PMR","Douche accessible, barres d’appui, WC surélevé aux normes.",{"_117":128,"_119":121},[125,126,127],"accessibilité","PMR","sanitaire","/sites-artisans/img/plombier/p5.jpg","p4","Dépannage fuite sous dalle","Recherche de fuite et réparation sans casser inutilement.",{"_117":136,"_119":130},[134,63,135],"dépannage","urgence","/sites-artisans/img/plombier/p4.jpg","p3","Douche à l’italienne","Receveur extra-plat, paroi fixe, évacuation optimisée.",{"_117":145,"_119":138},[142,143,144],"douche","italienne","étanchéité","/sites-artisans/img/plombier/p3.jpg","p2","Remplacement chaudière","Chaudière condensation gaz, radiateurs régulés pièce par pi