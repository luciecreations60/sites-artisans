[{"_1":2},"routes/demos.avance.layout",{"_3":4},"data",{"_5":6},"trade",{"_7":8,"_9":10,"_11":12,"_13":10,"_14":15,"_16":17,"_18":19,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47,"_48":49},"slug","menuisier","label","Menuisier","labelPlural","Menuisiers","shortLabel","tagline","Menuiserie sur mesure pour votre maison","specialty","Agencements, fenêtres et escaliers en bois","defaultFirstName","Julien","defaultLastName","Moreau","defaultCompany","Atelier Moreau Menuiserie","defaultCity","Annecy","defaultPhone","06 12 34 56 78","defaultEmail","contact@atelier-demo.fr","palette",{"_191":192,"_193":194,"_195":196,"_197":198,"_199":200,"_201":202},"hero",{"_116":189,"_118":190},"atelier",{"_116":186,"_118":188},"portrait",{"_116":186,"_118":187},"about","Je fabrique et pose des ouvrages en bois depuis quinze ans, en privilégiant le chêne et le pin des Alpes. Chaque projet est étudié avec vous pour s’adapter à votre intérieur et à votre budget. Je travaille seul ou avec un compagnon pour les chantiers plus importants.","services",[164,165,166,167,168],"projects",[97,98,99,100,101,102],"testimonials",[83,84,85],"faqs",[69,70,71,72],"estimator",{"_9":50,"_51":52},"Estimation fenêtres","options",[53,54,55],{"_56":66,"_9":67,"_59":68,"_61":62},{"_56":63,"_9":64,"_59":65,"_61":62},{"_56":57,"_9":58,"_59":60,"_61":62},"id","porte-ext","Porte extérieure bois","base",1800,"unit","€ / unité","fen-baie","Baie vitrée",1200,"fen-simple","Fenêtre standard",650,{"_73":81,"_75":82},{"_73":79,"_75":80},{"_73":77,"_75":78},{"_73":74,"_75":76},"question","Assurez-vous les ouvrages ?","answer","Tous mes travaux sont couverts par la garantie décennale et une garantie de parfait achèvement.","Proposez-vous un devis gratuit ?","Le déplacement et le devis détaillé sont gratuits dans un rayon de 30 km autour d’Annecy.","Travaillez-vous avec du bois local ?","Oui, je source auprès de scieries en Savoie et Haute-Savoie lorsque le projet le permet.","Quels délais pour une fenêtre sur mesure ?","Comptez environ quatre à six semaines entre la prise de mesures et la pose, selon la période.",{"_86":95,"_88":25,"_90":96},{"_86":92,"_88":93,"_90":94},{"_86":87,"_88":89,"_90":91},"name","Philippe R.","city","La Roche-sur-Foron","text","Remplacement de toutes nos fenêtres : devis clair, pose rapide, facture conforme au devis.","Marc et Sophie L.","Rumilly","Notre dressing sous combles est exactement ce qu’on imaginait. Travail soigné et chantier propre.","Claire D.","Escalier livré dans les délais, finition impeccable. Julien a su nous conseiller sur le choix du bois.",{"_56":155,"_104":156,"_106":25,"_107":157,"_109":158,"_111":159},{"_56":146,"_104":147,"_106":25,"_107":148,"_109":149,"_111":150},{"_56":137,"_104":138,"_106":25,"_107":139,"_109":140,"_111":141},{"_56":128,"_104":129,"_106":25,"_107":130,"_109":131,"_111":132},{"_56":119,"_104":120,"_106":25,"_107":121,"_109":122,"_111":123},{"_56":103,"_104":105,"_106":25,"_107":108,"_109":110,"_111":112},"p6","title","Véranda bois-alu","location","summary","Extension véranda avec structure bois et toiture vitrée.","image",{"_116":117,"_118":105},"tags",[113,114,115],"véranda","extension","lumière","src","/sites-artisans/img/menuisier/p6.jpg","alt","p5","Bibliothèque murale","Bibliothèque du sol au plafond avec échelle coulissante.",{"_116":127,"_118":120},[124,125,126],"bibliothèque","sur mesure","salon","/sites-artisans/img/menuisier/p5.jpg","p4","Porte d’entrée sur mesure","Porte blindée habillée bois, serrure multipoints.",{"_116":136,"_118":129},[133,134,135],"porte","sécurité","entrée","/sites-artisans/img/menuisier/p4.jpg","p3","Dressing sous combles","Aménagement complet sous rampant avec portes coulissantes.",{"_116":145,"_118":138},[142,143,144],"dressing","rangement","combles","/sites-artisans/img/menuisier/p3.jpg","p2","Baies vitrées salon","Trois baies coulissantes ouvrant sur le jardin, isolation renforcée.",{"_116":154,"_118":147},[151,152,153],"fenêtre","baie vitrée","isolation","/sites-artisans/img/menuisier/p2.jpg","p1","Escalier chêne massif","Escalier deux quart tournant en chêne, rampe tournée à la main.",{"_116":163,"_118":156},[160,161,162],"escalier","chêne","intérieur","/sites-artisans/img/menuisier/p1.jpg",{"_104":183,"_170":184,"_172":185},{"_104":180,"_170":181,"_172":182},{"_104":177,"_170":178,"_172":179},{"_104":174,"_170":175,"_172":176},{"_104":169,"_170":171,"_172":173},"Rénovation de parquet","description","Ponçage, vitrification ou huilage de parquets anciens et modernes.","priceFrom","35 €/m²","Cuisine bois","Plan de travail, façades et îlot en bois massif ou stratifié haut de gamme.","6 000 €","Placards et dressings","Agencement sur mesure avec tiroirs, étagères et portes coulissantes ou battantes.","1 200 €","Escaliers et garde-corps","Escaliers droits ou quart tournant, finitions huilées ou vernies selon vos goûts.","4 500 €","Fenêtres et portes sur mesure","Fabrication et pose de menuiseries bois ou mixte bois-aluminium, double vitrage inclus.","850 €","/sites-artisans/img/menuisier/atelier.jpg","Portrait artisan menuisier","Atelier menuisier","/sites-artisans/img/menuisier/hero.jpg","Menuisier — Agencements, fenêtres et escaliers en bois","ink","#2c2416","paper","#f7f3eb","muted","#8a7d6b","accent","#b8860b","accentSoft","#e8dcc4","surface","#efe8da"]
