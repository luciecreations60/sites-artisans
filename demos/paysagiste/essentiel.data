[{"_1":2},"routes/demos.essentiel",{"_3":4},"data",{"_5":6},"trade",{"_7":8,"_9":10,"_11":12,"_13":10,"_14":15,"_16":17,"_18":19,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47,"_48":49},"slug","paysagiste","label","Paysagiste","labelPlural","Paysagistes","shortLabel","tagline","Jardins durables et espaces verts sur mesure","specialty","Conception, plantation et entretien","defaultFirstName","Hélène","defaultLastName","Rousseau","defaultCompany","Rousseau Paysage","defaultCity","Toulouse","defaultPhone","06 12 34 56 78","defaultEmail","contact@atelier-demo.fr","palette",{"_200":201,"_202":203,"_204":205,"_206":207,"_208":209,"_210":211},"hero",{"_118":198,"_120":199},"atelier",{"_118":195,"_120":197},"portrait",{"_118":195,"_120":196},"about","Paysagiste diplômée, je conçois des jardins adaptés au climat toulousain et à votre mode de vie. Je privilégie les plantes locales et l’économie d’eau. Entretien régulier ou création complète : chaque projet commence par une visite sur place.","services",[173,174,175,176,177],"projects",[99,100,101,102,103,104],"testimonials",[85,86,87],"faqs",[71,72,73,74],"estimator",{"_9":50,"_51":52},"Estimation jardin","options",[53,54,55],{"_56":67,"_9":68,"_59":69,"_61":70},{"_56":63,"_9":64,"_59":65,"_61":66},{"_56":57,"_9":58,"_59":60,"_61":62},"id","terrasse","Terrasse bois","base",90,"unit","€ / m²","tonte","Tonte pelouse",45,"€ / passage","entretien","Entretien (petit jardin)",110,"€ / mois",{"_75":83,"_77":84},{"_75":81,"_77":82},{"_75":79,"_77":80},{"_75":76,"_77":78},"question","Travaillez-vous avec des matériaux recyclés ?","answer","Lorsque c’est pertinent : graviers reconstitués, bois certifié PEFC, compost local pour les massifs.","Quelle période pour planter ?","Automne et début printemps sont idéaux ; l’été on privilégie l’arrosage renforcé ou la reportation.","Entretenez-vous les pelouses synthétiques ?","Oui, nettoyage, brossage et désherbage des bordures pour garder un aspect naturel.","Proposez-vous des plans 3D ?","Un plan masse détaillé est inclus ; la vue 3D est disponible en option pour les projets de création.",{"_88":96,"_90":97,"_92":98},{"_88":94,"_90":25,"_92":95},{"_88":89,"_90":91,"_92":93},"name","Michel E.","city","Blagnac","text","Terrasse et éclairage posés en trois semaines. Conseils plantes très utiles.","Sandrine L.","Entretien mensuel depuis deux ans, jardin toujours propre sans que j’aie à m’en occuper.","Patrice N.","Colomiers","Notre jardin était invivable l’été : maintenant ombre, plantes résistantes et facture d’eau en baisse.",{"_56":156,"_106":157,"_108":25,"_109":158,"_111":159,"_113":160,"_161":162,"_163":164},{"_56":148,"_106":149,"_108":25,"_109":150,"_111":151,"_113":152},{"_56":139,"_106":140,"_108":25,"_109":141,"_111":142,"_113":143},{"_56":130,"_106":131,"_108":25,"_109":132,"_111":133,"_113":134},{"_56":121,"_106":122,"_108":25,"_109":123,"_111":124,"_113":125},{"_56":105,"_106":107,"_108":25,"_109":110,"_111":112,"_113":114},"p6","title","Cour minérale et graminées","location","summary","Pavés et plantes sèches, zéro entretien intensif.","image",{"_118":119,"_120":107},"tags",[115,116,117],"minéral","graminées","contemporain","src","/sites-artisans/img/paysagiste/p6.jpg","alt","p5","Potager surélevé","Bacs en Douglas, compost intégré, irrigation goutte-à-goutte.",{"_118":129,"_120":122},[126,127,128],"potager","bio","légumes","/sites-artisans/img/paysagiste/p5.jpg","p4","Massif fleuri printemps","Bulbes et vivaces pour floraison de mars à octobre.",{"_118":138,"_120":131},[135,136,137],"massif","fleurs","saison","/sites-artisans/img/paysagiste/p4.jpg","p3","Haie brise-vue","Claustras bois et laurier cerise pour intimité vis-à-vis.",{"_118":147,"_120":140},[144,145,146],"clôture","intimité","haie","/sites-artisans/img/paysagiste/p3.jpg","p2","Terrasse ombragée","Pergola bioclimatique, dalles grès et éclairage basse tension.",{"_118":155,"_120":149},[57,153,154],"pergola","détente","/sites-artisans/img/paysagiste/p2.jpg","p1","Jardin méditerranéen","Oliviers, lavandes et gravier stabilisé, arrosage localisé.",{"_118":172,"_120":157},[169,170,171],"before",{"_118":167,"_120":168},"after",{"_118":165,"_120":166},"/sites-artisans/img/paysagiste/apres.jpg","Après — Jardin méditerranéen","/sites-artisans/img/paysagiste/avant.jpg","Avant — Jardin méditerranéen","création","méditerranéen","plantation","/sites-artisans/img/paysagiste/p1.jpg",{"_106":192,"_179":193,"_181":194},{"_106":189,"_179":190,"_181":191},{"_106":186,"_179":187,"_181":188},{"_106":183,"_179":184,"_181":185},{"_106":178,"_179":180,"_181":182},"Arrosage automatique","description","Programmation, goutte-à-goutte massifs et pelouse, sonde pluie.","priceFrom","1 800 €","Clôtures et portails","Grillage rigide, claustras bois ou vegetal, portillon sur mesure.","65 €/ml","Terrasse et dallage","Bois composite, pierre naturelle ou grès cérame sur plots ou dalle.","95 €/m²","Entretien mensuel","Tonte, taille haies, désherbage massifs et contrôle arrosage.","120 €/mois","Création de jardin","Plan masse, terrassement léger, plantation et arrosage automatique.","85 €/m²","/sites-artisans/img/paysagiste/atelier.jpg","Portrait artisan paysagiste","Atelier paysagiste","/sites-artisans/img/paysagiste/hero.jpg","Paysagiste — Conception, plantation et entretien","ink","#1b3d2f","paper","#f6fbf7","muted","#6b8f7a","accent","#2d6a4f","accentSoft","#d8f3dc","surface","#e8f5e9"]
