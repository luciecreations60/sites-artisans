[{"_1":2},"routes/demos.avance.layout",{"_3":4},"data",{"_5":6},"trade",{"_7":8,"_9":10,"_11":12,"_13":10,"_14":15,"_16":17,"_18":19,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47,"_48":49},"slug","macon","label","Maçon","labelPlural","Maçons","shortLabel","tagline","Gros œuvre, extensions et rénovation","specialty","Murs, dalles, ouvertures et enduits","defaultFirstName","Antoine","defaultLastName","Martinez","defaultCompany","Martinez Maçonnerie","defaultCity","Montpellier","defaultPhone","06 12 34 56 78","defaultEmail","contact@atelier-demo.fr","palette",{"_198":199,"_200":201,"_202":203,"_204":205,"_206":207,"_208":209},"hero",{"_117":196,"_119":197},"atelier",{"_117":193,"_119":195},"portrait",{"_117":193,"_119":194},"about","Maçon depuis vingt ans, je réalise extensions, murs de clôture, reprises sous œuvre et ravalements. Je coordonne avec les autres corps d’état quand le chantier l’exige. Chaque ouvrage est couvert par la garantie décennale.","services",[171,172,173,174,175],"projects",[98,99,100,101,102,103],"testimonials",[84,85,86],"faqs",[70,71,72,73],"estimator",{"_9":50,"_51":52},"Estimation maçonnerie","options",[53,54,55],{"_56":67,"_9":68,"_59":69,"_61":66},{"_56":63,"_9":64,"_59":65,"_61":66},{"_56":57,"_9":58,"_59":60,"_61":62},"id","cloture","Mur clôture","base",165,"unit","€ / ml","dalle","Dalle béton",70,"€ / m²","mur","Mur parpaing",95,{"_74":82,"_76":83},{"_74":80,"_76":81},{"_74":78,"_76":79},{"_74":75,"_76":77},"question","Réalisez-vous le gros œuvre seul ?","answer","Oui pour la maçonnerie ; charpente, couverture et menuiseries passent par des partenaires de confiance.","Comment se paie le chantier ?","Acompte au démarrage, situations intermédiaires sur gros œuvre, solde à réception.","Intervenez-vous sur l’ancien en pierre ?","Oui, rejointoiement, reprise de linteaux et consolidation avec matériaux compatibles.","Faut-il un permis pour une extension ?","Au-delà de certaines surfaces, oui. Je vous indique déclaration préalable ou permis selon le projet.",{"_87":95,"_89":96,"_91":97},{"_87":93,"_89":25,"_91":94},{"_87":88,"_89":90,"_91":92},"name","Gérard F.","city","Lattes","text","Mur de clôture solide et bien aligné. Antoine explique chaque étape.","Valérie J.","Ouverture du mur cuisine-salon parfaite, pas de fissure six mois après.","Rachid O.","Castelnau-le-Lez","Extension livrée comme prévu au devis. Chantier sécurisé, équipe sympa.",{"_56":154,"_105":155,"_107":25,"_108":156,"_110":157,"_112":158,"_159":160,"_161":162},{"_56":146,"_105":147,"_107":25,"_108":148,"_110":149,"_112":150},{"_56":138,"_105":139,"_107":25,"_108":140,"_110":141,"_112":142},{"_56":129,"_105":130,"_107":25,"_108":131,"_110":132,"_112":133},{"_56":120,"_105":121,"_107":25,"_108":122,"_110":123,"_112":124},{"_56":104,"_105":106,"_107":25,"_108":109,"_110":111,"_112":113},"p6","title","Réparation fissures façade","location","summary","Injections et armatures, enduit monocouche couleur sable.","image",{"_117":118,"_119":106},"tags",[114,115,116],"façade","fissure","enduit","src","/sites-artisans/img/macon/p6.jpg","alt","p5","Garage en parpaing","Box 30 m², porte sectionnelle réservée, dalle armée.",{"_117":128,"_119":121},[125,126,127],"garage","construction","box","/sites-artisans/img/macon/p5.jpg","p4","Ouverture cuisine ouverte","IPN dissimulé, plâtre et peinture coordonnés avec le client.",{"_117":137,"_119":130},[134,135,136],"ouverture","porteur","rénovation","/sites-artisans/img/macon/p4.jpg","p3","Terrasse béton carrelée","Dalle 35 m² avec drain et reprise étanchéité avant pose grès.",{"_117":145,"_119":139},[63,143,144],"terrasse","béton","/sites-artisans/img/macon/p3.jpg","p2","Mur clôture parpaing","Mur 2 m sur longueur 25 m, portillon maçonné et enduit deux tons.",{"_117":153,"_119":147},[151,67,152],"clôture","extérieur","/sites-artisans/img/macon/p2.jpg","p1","Extension salon 20 m²","Dalle isolée, murs R+1 alignés sur l’existant, fen