[{"_1":2},"routes/demos.trade",{"_3":4},"data",{"_5":6},"trade",{"_7":8,"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48,"_49":50},"slug","coiffure","label","Coiffeur / Barbier","labelPlural","Coiffeurs","shortLabel","Coiffure","tagline","Coupe, couleur et barbier sur rendez-vous","specialty","Salon de quartier, femmes et hommes","defaultFirstName","Samir","defaultLastName","Aït","defaultCompany","Salon Aït Coiffure","defaultCity","Marseille","defaultPhone","06 12 34 56 78","defaultEmail","contact@atelier-demo.fr","palette",{"_187":188,"_189":190,"_191":192,"_193":194,"_195":196,"_197":198},"hero",{"_117":185,"_119":186},"atelier",{"_117":182,"_119":184},"portrait",{"_117":182,"_119":183},"about","Coiffeur-barbier, j’accueille hommes, femmes et enfants dans un salon calme du centre-ville. Je prends le temps du conseil couleur et de la coupe adaptée à votre visage. Produits professionnels sans surcharge de marque inutile.","services",[161,162,163,164,165],"projects",[98,99,100,101,102,103],"testimonials",[84,85,86],"faqs",[70,71,72,73],"estimator",{"_9":51,"_52":53},"Estimation coiffure","options",[54,55,56],{"_57":67,"_9":68,"_60":69,"_62":63},{"_57":64,"_9":65,"_60":66,"_62":63},{"_57":58,"_9":59,"_60":61,"_62":63},"id","couleur","Couleur racines","base",52,"unit","€","femme","Coupe femme",38,"homme","Coupe homme",22,{"_74":82,"_76":83},{"_74":80,"_76":81},{"_74":78,"_76":79},{"_74":75,"_76":77},"question","Quels produits utilisez-vous ?","answer","Gammes professionnelles sans parabènes pour la couleur, shampoings doux pour usage fréquent.","Faites-vous les extensions ?","Pose à froid et retouches sur devis après diagnostic de vos cheveux naturels.","Acceptez-vous les cartes titre ?","Nous acceptons les titres restaurant sur la partie snacking si vous prenez un café ou un soin retail.","Faut-il réserver ?","Oui, par téléphone ou en ligne. Quelques créneaux sans RDV le mardi matin pour hommes.",{"_87":95,"_89":96,"_91":97},{"_87":93,"_89":26,"_91":94},{"_87":88,"_89":90,"_91":92},"name","Léa F.","city","Aix-en-Provence","text","Chignon de mariage tenu toute la nuit, essai rassurant la semaine d’avant.","Olivier P.","Meilleur dégradé du quartier, pas d’attente interminable avec le rendez-vous.","Yasmine B.","Marseille 6e","Samir écoute vraiment ce qu’on veut. Mon balayage tient bien entre deux visites.",{"_57":154,"_105":155,"_107":26,"_108":156,"_110":157,"_112":158},{"_57":146,"_105":147,"_107":26,"_108":148,"_110":149,"_112":150},{"_57":137,"_105":138,"_107":26,"_108":139,"_110":140,"_112":141},{"_57":128,"_105":129,"_107":26,"_108":130,"_110":131,"_112":132},{"_57":120,"_105":121,"_107":26,"_108":122,"_110":123,"_112":124},{"_57":104,"_105":106,"_107":26,"_108":109,"_110":111,"_112":113},"p6","title","Transformation coupe longue","location","summary","Coupe longueur épaules avec frange rideau, conseil entretien maison.","image",{"_117":118,"_119":106},"tags",[114,115,116],"transformation","conseil","salon","src","/sites-artisans/img/coiffure/p6.jpg","alt","p5","Coloration végétale","Teintes plantes sur cheveux sensibilisés, test mèche préalable.",{"_117":127,"_119":121},[125,126,58],"naturel","soin","/sites-artisans/img/coiffure/p5.jpg","p4","Chignon mariage","Chignon bas fleuri, essai inclus une semaine avant.",{"_117":136,"_119":129},[133,134,135],"mariage","chignon","événement","/sites-artisans/img/coiffure/p4.jpg","p3","Coupe pixie structurée","Volume sur cheveux fins, texturisation ciseaux.",{"_117":145,"_119":138},[142,143,144],"coupe","court","tendance","/sites-artisans/img/coiffure/p3.jpg","p2","Dégradé barbe sculptée","Dégradé bas, barbe taillée au rasoir et huile apaisante.",{"_117":153,"_119":147},[151,67,152],"barbe","barbier","/sites-artisans/img/coiffure/p2.jpg","p1","Balayage naturel","Éclaircissement progressif sans démarcation, patine cendrée.",{"_117":160,"_119":155},[58,159,64]