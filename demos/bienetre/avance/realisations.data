[{"_1":2},"routes/demos.avance.layout",{"_3":4},"data",{"_5":6},"trade",{"_7":8,"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48,"_49":50},"slug","bienetre","label","Bien-être / Beauté","labelPlural","Professionnels du bien-être","shortLabel","Bien-être","tagline","Soins du corps et du visage en institut","specialty","Massages, esthétique et relaxation","defaultFirstName","Marine","defaultLastName","Chevalier","defaultCompany","Institut Marine Chevalier","defaultCity","Nice","defaultPhone","06 12 34 56 78","defaultEmail","contact@atelier-demo.fr","palette",{"_191":192,"_193":194,"_195":196,"_197":198,"_199":200,"_201":202},"hero",{"_117":189,"_119":190},"atelier",{"_117":186,"_119":188},"portrait",{"_117":186,"_119":187},"about","Esthéticienne-masseuse, je propose soins du visage, massages bien-être et épilations dans un institut calme à deux pas de la Promenade. Chaque soin débute par un court échange pour adapter pression et produits. Hygiène et confort sont prioritaires.","services",[164,165,166,167,168],"projects",[98,99,100,101,102,103],"testimonials",[84,85,86],"faqs",[70,71,72,73],"estimator",{"_9":51,"_52":53},"Estimation soins","options",[54,55,56],{"_57":67,"_9":68,"_60":69,"_62":63},{"_57":64,"_9":65,"_60":66,"_62":63},{"_57":58,"_9":59,"_60":61,"_62":63},"id","manucure","Manucure semi-permanent","base",42,"unit","€","visage","Soin visage",58,"massage-45","Massage 45 min",65,{"_74":82,"_76":83},{"_74":80,"_76":81},{"_74":78,"_76":79},{"_74":75,"_76":77},"question","Quels moyens de paiement ?","answer","Carte bancaire, espèces et paiement en plusieurs fois sans frais à partir de 150 €.","Proposez-vous des cartes cadeaux ?","Oui, montant libre ou forfait soin, validité un an, remise en main propre ou par mail.","Les soins sont-ils adaptés aux femmes enceintes ?","Massages spécifiques à partir du 4e mois sur devis médical ; certains soins visage sans actifs forts.","Comment annuler un rendez-vous ?","Merci de prévenir 24 h à l’avance par SMS ou téléphone, sinon la prestation peut être facturée.",{"_87":96,"_89":26,"_91":97},{"_87":93,"_89":94,"_91":95},{"_87":88,"_89":90,"_91":92},"name","Julien et Anaïs","city","Antibes","text","Rituel duo pour notre anniversaire : moment simple et très agréable.","Carole S.","Cagnes-sur-Mer","Soin visage sans agresser ma peau sensible. Marine explique chaque étape.","Émilie R.","Institut propre et accueillant. Le massage 60 min m’a vraiment détendue, pression parfaite.",{"_57":155,"_105":156,"_107":26,"_108":157,"_110":158,"_112":159},{"_57":147,"_105":148,"_107":26,"_108":149,"_110":150,"_112":151},{"_57":138,"_105":139,"_107":26,"_108":140,"_110":141,"_112":142},{"_57":129,"_105":130,"_107":26,"_108":131,"_110":132,"_112":133},{"_57":120,"_105":121,"_107":26,"_108":122,"_110":123,"_112":124},{"_57":104,"_105":106,"_107":26,"_108":109,"_110":111,"_112":113},"p6","title","Atelier relaxation entreprise","location","summary","Séance 20 min chaise pour équipe de dix, sur site ou en institut.","image",{"_117":118,"_119":106},"tags",[114,115,116],"entreprise","stress","événement","src","/sites-artisans/img/bienetre/p6.jpg","alt","p5","Gommage corps et enveloppement","Gommage sel marin puis enveloppe algues, peau lisse.",{"_117":128,"_119":121},[125,126,127],"corps","gommage","spa","/sites-artisans/img/bienetre/p5.jpg","p4","Réflexologie plantaire","Points réflexes pieds 30 min, relâchement jambes lourdes.",{"_117":137,"_119":130},[134,135,136],"réflexologie","bien-être","pieds","/sites-artisans/img/bienetre/p4.jpg","p3","Forfait mariée","Soin visage, manucure et coiffure légère la veille du mariage.",{"_117":146,"_119":139},[143,144,145],"mariage","beauté","forfait","/sites-artisans/img/bienetre/p3.jpg","p2","Soin anti-âge visage","Acide hyaluronique et massage liftant, peau repulpée visiblement.",{"_117":154,"_119":148},[64,152,153],"anti-âge","soin","/sites-a