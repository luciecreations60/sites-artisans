[{"_1":2},"routes/demos.pro.layout",{"_3":4},"data",{"_5":6},"trade",{"_7":8,"_9":10,"_11":12,"_13":10,"_14":15,"_16":17,"_18":19,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47,"_48":49},"slug","peintre","label","Peintre","labelPlural","Peintres","shortLabel","tagline","Peinture intérieure et extérieure soignée","specialty","Préparation des supports et finitions durables","defaultFirstName","Laura","defaultLastName","Girard","defaultCompany","Girard Peinture Déco","defaultCity","Bordeaux","defaultPhone","06 12 34 56 78","defaultEmail","contact@atelier-demo.fr","palette",{"_199":200,"_201":202,"_203":204,"_205":206,"_207":208,"_209":210},"hero",{"_116":197,"_118":198},"atelier",{"_116":194,"_118":196},"portrait",{"_116":194,"_118":195},"about","Peintre en bâtiment, je prépare correctement les murs avant d’appliquer peintures, enduits ou papier peint. Je travaille avec des marques professionnelles adaptées aux pièces humides et aux façades. Les chantiers sont protégés et laissés propres en fin de journée.","services",[172,173,174,175,176],"projects",[97,98,99,100,101,102],"testimonials",[83,84,85],"faqs",[69,70,71,72],"estimator",{"_9":50,"_51":52},"Estimation peinture","options",[53,54,55],{"_56":66,"_9":67,"_59":68,"_61":62},{"_56":63,"_9":64,"_59":65,"_61":62},{"_56":57,"_9":58,"_59":60,"_61":62},"id","facade","Façade","base",42,"unit","€ / m²","plafond","Plafonds",32,"mur","Murs intérieurs",28,{"_73":81,"_75":82},{"_73":79,"_75":80},{"_73":77,"_75":78},{"_73":74,"_75":76},"question","Fournissez-vous les peintures ?","answer","Oui, incluses dans le devis sauf si vous préférez les acheter vous-même ; j’indique alors les références.","Peut-on peindre en hiver ?","En intérieur oui, avec aération. En extérieur, température et sécheresse doivent rester dans les tolérances produit.","Quelle peinture pour une salle de bain ?","Peinture spéciale pièces humides avec traitement anti-moisissures en sous-couche si besoin.","Dois-je vider les pièces ?","Idéalement oui pour les murs complets. Sinon je déplace et bâche les meubles lourds avec vous.",{"_86":94,"_88":95,"_90":96},{"_86":92,"_88":25,"_90":93},{"_86":87,"_88":89,"_90":91},"name","Julie et Paul S.","city","Pessac","text","Peinture de toute la maison en une semaine. Prix conforme au devis.","François A.","Façade ravivée, voisins complimentés. Laura a bien géré la coordination avec l’échafaudage.","Camille B.","Mérignac","Travail très propre, couleurs exactement comme les nuanciers. Délais tenus.",{"_56":155,"_104":156,"_106":25,"_107":157,"_109":158,"_111":159,"_160":161,"_162":163},{"_56":146,"_104":147,"_106":25,"_107":148,"_109":149,"_111":150},{"_56":137,"_104":138,"_106":25,"_107":139,"_109":140,"_111":141},{"_56":128,"_104":129,"_106":25,"_107":130,"_109":131,"_111":132},{"_56":119,"_104":120,"_106":25,"_107":121,"_109":122,"_111":123},{"_56":103,"_104":105,"_106":25,"_107":108,"_109":110,"_111":112},"p6","title","Escalier et paliers","location","summary","Sous-couche accrochage sur anciennes peintures glycéro, laque blanche.","image",{"_116":117,"_118":105},"tags",[113,114,115],"boiseries","escalier","laque","src","/sites-artisans/img/peintre/p6.jpg","alt","p5","Maison neuve finitions","Prise en charge complète après plâtrier : plafonds et murs livrés prêts à meubler.",{"_116":127,"_118":120},[124,125,126],"neuf","finitions","maison","/sites-artisans/img/peintre/p5.jpg","p4","Bureaux open space","Peinture lessivable blanc cassé, bandes de couleur sur cloisons.",{"_116":136,"_118":129},[133,134,135],"bureaux","professionnel","peinture","/sites-artisans/img/peintre/p4.jpg","p3","Salon papier panoramique","Papier intissé grand format, raccord invisible au plafond.",{"_116":145,"_118":138},[142,143,144],"papier peint","décoration","salon","/sites-artisans/img/peintre/p3.jpg","p2","Façade pierre Bordeaux","Ravalement deux tons, encadrements plus foncés, corniches restaurées.",{"_116":154,"_118":147},